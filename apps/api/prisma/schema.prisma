generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Level {
  NOVICE
  APPRENTICE
  RIDDLER
  ENIGMATIST
  MASTER_OF_MINDS
}

enum Mode {
  PRACTICE
  EXHIBITION
  WEEKLY
  LEGENDARY
  SPONSORED
}

enum RiddleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  FILLING
  LIVE
  SOLVED
  ROLLED_OVER
  REFUNDED
  CLOSED_UNSOLVED
  PAUSED
}

enum PieceCategory {
  MATHS
  HISTORY
  LOGIC
  CIPHER
  SOCIAL_CLUE
}

enum EntrySource {
  USDT
  GAME_CARD
  FREE
}

enum AttemptResult {
  PENDING_REVEAL
  CORRECT
  WRONG
  EXPIRED
}

enum LedgerAccount {
  USER_AVAILABLE
  USER_PROMO
  WITHDRAWAL_PENDING
  PAYOUT_PENDING
  REFERRAL_PENDING
  POT
  PLATFORM_REVENUE
  GAME_RESERVE
  SPONSOR_ESCROW
  DEPOSIT_CLEARING
}

enum TxStatus {
  DETECTED
  CONFIRMED
  FAILED
  BROADCAST
  SENT
}

enum Chain {
  POLYGON
  SOLANA
}

model User {
  id                   String    @id @default(uuid(7))
  email                String    @unique
  googleSub            String?   @unique
  username             String    @unique
  phoneE164            String?   @unique
  phoneVerifiedAt      DateTime?
  ageConfirmedAt       DateTime?
  termsVersion         String?
  countryCode          String?
  level                Level     @default(NOVICE)
  exhibitionWinsAtLevel Int      @default(0)
  practiceCompleted    Boolean   @default(false)
  gameCardGrantedAt    DateTime?
  referralCode         String?   @unique
  referredById         String?
  bonusAttempts        Int       @default(0)
  weeklyLimitMicro     BigInt?
  breakUntil           DateTime?
  showOnWinnersWall    Boolean   @default(true)
  showWinAmount        Boolean   @default(true)
  allowStory           Boolean   @default(false)
  frozenAt             DateTime?
  role                 String    @default("PLAYER")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  wallets       Wallet[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid(7))
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id            String   @id @default(uuid(7))
  userId        String
  chain         Chain
  address       String   @unique
  tokenAccount  String?
  derivationIdx Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, chain])
  @@unique([chain, derivationIdx])
}

model PayoutVerification {
  id              String   @id @default(uuid(7))
  withdrawalId    String   @unique
  payoutWalletId  String
  testAmountHash  String
  testAmountMicro BigInt
  testTxId        String?
  remainderTxId   String?
  state           String
  tries           Int      @default(0)
  testSends       Int      @default(0)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PayoutWallet {
  id          String    @id @default(uuid(7))
  userId      String
  chain       Chain
  address     String
  isPreferred Boolean   @default(false)
  verifiedAt  DateTime
  holdUntil   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, chain])
}

model ReserveSnapshot {
  id               String   @id @default(uuid(7))
  chain            Chain
  reserveMicro     BigInt
  hotMicro         BigInt
  minRequiredMicro BigInt
  headroomMicro    BigInt
  breakdown        Json
  createdAt        DateTime @default(now())
}

model EconomySettings {
  id        String   @id @default(uuid(7))
  version   Int      @unique
  data      Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Riddle {
  id              String       @id @default(uuid(7))
  number          Int          @unique
  title           String
  story           String       @db.Text
  mode            Mode
  level           Level?
  status          RiddleStatus @default(DRAFT)
  difficulty      String
  finalHash       String
  salt            String
  answerLength    Int
  solutionCipher  Bytes?
  solverCheck     String?
  startsAt        DateTime?
  endsAt          DateTime?
  entryFeesMicro  Json
  prizeMicro      BigInt?
  minPlayers      Int?
  potMicro        BigInt       @default(0)
  sponsorId       String?
  settingsVersion Int
  winnerEntryId   String?      @unique
  solvedAt        DateTime?
  rolledFromId    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  pieces  Piece[]
  entries Entry[]

  @@index([mode, status])
}

model Piece {
  id         String        @id @default(uuid(7))
  riddleId   String
  order      Int
  category   PieceCategory
  title      String
  question   String        @db.Text
  answerHash String
  dropAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  riddle Riddle @relation(fields: [riddleId], references: [id])

  @@unique([riddleId, order])
}

model Entry {
  id             String      @id @default(uuid(7))
  riddleId       String
  userId         String
  feeMicro       BigInt
  source         EntrySource
  attemptsLeft   Int         @default(3)
  nextAttemptAt  DateTime?
  refundedAt     DateTime?
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  riddle   Riddle    @relation(fields: [riddleId], references: [id])
  attempts Attempt[]

  @@index([riddleId, userId])
}

model PieceProgress {
  userId        String
  pieceId       String
  solvedAt      DateTime?
  checksUsed    Int       @default(0)
  checksResetAt DateTime?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@id([userId, pieceId])
}

model Attempt {
  id          String        @id @default(uuid(7))
  entryId     String
  commit      String
  committedAt DateTime      @default(now())
  revealedAt  DateTime?
  result      AttemptResult @default(PENDING_REVEAL)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  entry Entry @relation(fields: [entryId], references: [id])

  @@index([entryId])
}

model LedgerLine {
  id        String        @id @default(uuid(7))
  txGroupId String
  account   LedgerAccount
  ownerId   String?
  amount    BigInt
  kind      String
  refType   String?
  refId     String?
  createdAt DateTime      @default(now())

  @@index([account, ownerId])
  @@index([txGroupId])
}

model ChainTx {
  id            String   @id @default(uuid(7))
  chain         Chain
  direction     String
  userId        String?
  hash          String   @unique
  logIndex      Int?
  fromAddr      String
  toAddr        String
  amountMicro   BigInt
  blockNumber   Int?
  confirmations Int      @default(0)
  status        TxStatus
  ledgerGroupId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Withdrawal {
  id             String   @id @default(uuid(7))
  userId         String
  chain          Chain
  kind           String
  toAddr         String
  amountMicro    BigInt
  status         String
  chainTxId      String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Sponsor {
  id            String   @id @default(uuid(7))
  name          String
  logoUrl       String
  url           String
  terms         String   @db.Text
  escrowAddress String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SocialClue {
  id         String    @id @default(uuid(7))
  pieceId    String
  platform   String
  text       String    @db.Text
  imageUrl   String?
  dropAt     DateTime
  status     String
  postUrl    String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Story {
  id        String   @id @default(uuid(7))
  entryId   String   @unique
  type      String
  videoUrl  String?
  quote     String?
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(uuid(7))
  userId    String
  type      String
  title     String
  body      String    @db.Text
  readAt    DateTime?
  data      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model NotificationPref {
  userId    String
  type      String
  push      Boolean
  email     Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, type])
}

model OtpCode {
  id        String   @id @default(uuid(7))
  target    String
  purpose   String
  codeHash  String
  expiresAt DateTime
  tries     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([target, purpose])
}

model AuditLog {
  id        String   @id @default(uuid(7))
  actorId   String
  action    String
  target    String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
}
